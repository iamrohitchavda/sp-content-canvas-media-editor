# Lambda runs the renderer from this Linux image. Puppeteer downloads the Linux
# Chrome binary during npm ci; ffmpeg-installer provides the matching ffmpeg.
FROM node:20-bookworm AS build

WORKDIR /build
COPY package.json package-lock.json ./
RUN npm ci
COPY server ./server
RUN npx tsc -p server

FROM public.ecr.aws/lambda/nodejs:20

WORKDIR ${LAMBDA_TASK_ROOT}
# Puppeteer's downloaded Chrome needs these Amazon Linux shared libraries at
# runtime. Lambda base images intentionally omit desktop-browser dependencies.
RUN dnf install -y \
  alsa-lib \
  atk \
  at-spi2-atk \
  cups-libs \
  gtk3 \
  libX11 \
  libXcomposite \
  libXcursor \
  libXdamage \
  libXext \
  libXfixes \
  libXi \
  libXrandr \
  libXrender \
  libXtst \
  libdrm \
  libxcb \
  libxkbcommon \
  mesa-libgbm \
  nspr \
  nss \
  pango \
  xorg-x11-fonts-Type1 \
  && dnf clean all

ENV PUPPETEER_CACHE_DIR=${LAMBDA_TASK_ROOT}/.cache/puppeteer
COPY package.json package-lock.json ./
RUN npm ci --omit=dev
COPY --from=build /build/server/dist ./server/dist

CMD ["server/dist/lambda/handler.handler"]
